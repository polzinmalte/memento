# Rust
/target/
**/*.rs.bk

# Tauri codegen — regenerated by tauri-build on every build.
/src-tauri/gen/

# Model weights. These are hundreds of megabytes each and are fetched on first
# run into %LOCALAPPDATA%\memento\models (or ~/.local/share/memento/models), so
# they should never be committed even if someone points the model dir here.
*.bin
*.onnx
*.partial

# Captured and generated audio. Meeting audio is the most sensitive thing this
# project touches, and the lane spill lands next to the code during development.
*.wav
*.aiff
*.aif

# Transcripts. Same reason — these are the contents of real meetings.
memento_*.md

# macOS / Windows / editors
.DS_Store
Thumbs.db
desktop.ini
/.idea/
/.vscode/
*.swp
