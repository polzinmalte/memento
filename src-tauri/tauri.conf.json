{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memento",
  "version": "0.1.0",
  "identifier": "in.polz.memento",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "memento",
        "width": 900,
        "height": 700,
        "minWidth": 620,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "bundled/*.dll": ""
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico"],
    "shortDescription": "Local meeting transcriber",
    "longDescription": "Transcribes meetings locally. Captures your microphone and one application's audio as separate lanes; nothing leaves the machine and nothing joins the call."
  }
}
